{
  "expo": {
    "name": "Milano Foods",
    "slug": "milanofoods",
    "scheme": "com.ruslandev.milanofoods",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/milano_icon_512.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ruslandev.milanofoods",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ushbu ilova manzilingizni aniqlash uchun ruxsat so'raydi.",
        "NSLocationAlwaysUsageDescription": "Ushbu ilova orqa fonda ham manzilingizni aniqlash uchun ruxsat so'raydi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/milano_icon_512.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "milanofoods.ruslandev.uz",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/milano_icon_512.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ushbu ilova manzilingizni aniqlash uchun ruxsat so'raydi."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7fdcf686-3104-4471-aa24-cad80a2fab1a"
      }
    }
  }
}
